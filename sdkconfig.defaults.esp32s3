# ==================== ESP32S3 特定配置 ====================

# ==================== Flash 配置 ====================
# 设置 Flash 大小为 16MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 设置 Flash 模式为 QIO (四线输入输出)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# ==================== CPU 配置 ====================
# 设置默认 CPU 频率为 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ==================== 外部 RAM 配置 ====================
# 启用外部 SPI RAM
CONFIG_SPIRAM=y
# 设置 SPI RAM 模式为八线模式
CONFIG_SPIRAM_MODE_OCT=y
# 设置 SPI RAM 速度为 80MHz
CONFIG_SPIRAM_SPEED_80M=y
# SPI RAM 分配始终内部使用的大小 (字节)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
# SPI RAM 分配保留内部内存的大小 (字节)
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# 禁用 SPI RAM 内存测试
CONFIG_SPIRAM_MEMTEST=n
# 启用 mbedTLS 外部内存分配
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ==================== WiFi 配置 ====================
# WiFi 静态 RX 缓冲区数量
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
# WiFi 动态 RX 缓冲区数量
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
# WiFi RX 块确认窗口大小
CONFIG_ESP_WIFI_RX_BA_WIN=3
# LWIP TCP/IP 接收邮箱大小
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
# 启用 mbedTLS 动态释放配置数据
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# ==================== 缓存配置 ====================
# 设置 ESP32S3 指令缓存大小为 32KB
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
# 设置 ESP32S3 数据缓存行大小为 64B
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ==================== TTS 配置 ====================
# 启用 SR_WN_WN9_NIHAOXIAOZHI_TTS
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

# ==================== 系统配置 ====================
# ESP 系统事件任务栈大小
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# ==================== USB 配置 ====================
# USB 主机控制传输最大大小
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# ==================== LVGL 图形配置 ====================
# 启用 LVGL 快照功能
CONFIG_LV_USE_SNAPSHOT=y

# 自定义分区表文件路径 覆盖 skdconfig.defaults skdconfig
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/16m.csv"